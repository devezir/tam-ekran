<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ana Ekran Teması: Duvar kağıdını arkada gösterir, sıfır başlık -->
    <style name="Tema.TamEkran" parent="@android:style/Theme.Wallpaper.NoTitleBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Ayarlar Ekranı Teması: Şık AMOLED Koyu Tema -->
    <style name="Tema.TamEkran.Ayarlar" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/renk_panel</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Tasarım Felsefesi: İçeriğe Göre Esneyen Standart Düğme Stilleri -->
    <style name="TamEkran.Dugme" parent="@android:style/Widget.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/buton_min_yukseklik</item>
        <item name="android:paddingLeft">@dimen/buton_ic_bosluk_yatay</item>
        <item name="android:paddingRight">@dimen/buton_ic_bosluk_yatay</item>
        <item name="android:paddingTop">@dimen/buton_ic_bosluk_dikey</item>
        <item name="android:paddingBottom">@dimen/buton_ic_bosluk_dikey</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/kart_arkaplan</item>
        <item name="android:textColor">@color/renk_yazi_ana</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TamEkran.Dugme.Vurgu" parent="TamEkran.Dugme">
        <item name="android:textColor">@color/renk_vurgu</item>
    </style>

    <style name="TamEkran.Dugme.Ikincil" parent="TamEkran.Dugme">
        <item name="android:textColor">@color/renk_yazi_ikincil</item>
    </style>

    <style name="TamEkran.Dugme.Kompakt" parent="@android:style/Widget.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/buton_kompakt_min_yukseklik</item>
        <item name="android:paddingLeft">@dimen/buton_kompakt_ic_bosluk_yatay</item>
        <item name="android:paddingRight">@dimen/buton_kompakt_ic_bosluk_yatay</item>
        <item name="android:paddingTop">@dimen/buton_kompakt_ic_bosluk_dikey</item>
        <item name="android:paddingBottom">@dimen/buton_kompakt_ic_bosluk_dikey</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/kart_arkaplan</item>
        <item name="android:textColor">@color/renk_yazi_ana</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
