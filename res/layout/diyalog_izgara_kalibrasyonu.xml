<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/kart_guvenli_alan"
    android:padding="14dp"
    android:layout_margin="10dp">

    <!-- 1. Başlık ve Yüzen Konum Değiştirme Butonu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/yazi_baslik"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📐 Canlı Düzen Stüdyosu"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/dugme_konum"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/kart_arkaplan"
            android:text="📌 Üste Al"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

    </LinearLayout>

    <!-- 2. Sabit 3 Sekme (Masaüstü | Çekmece | Alt Bar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/buton_kompakt_min_yukseklik"
        android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
        android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/dugme_sekme_masaustu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="3dp"
            android:background="@drawable/kart_arkaplan"
            android:text="🏠 Masaüstü"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/dugme_sekme_cekmece"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:background="@drawable/kart_arkaplan"
            android:text="📱 Çekmece"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/dugme_sekme_dock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:background="@drawable/kart_arkaplan"
            android:text="⚓ Alt Bar"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 3. Dikey Kaydırılabilir Orta Kontroller Alanı -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="265dp"
        android:fadeScrollbars="false"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingRight="2dp">

            <!-- SLIDER 1: Satır Sayısı (Masaüstü/Çekmece) veya Yükseklik (Alt Bar) -->
            <TextView
                android:id="@+id/yazi_etiket_satir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↕️ Satır Sayısı (Rows): 6"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/dugme_satir_eksi"
                    android:layout_width="wrap_content"
                    android:minWidth="@dimen/buton_kompakt_min_yukseklik"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="−"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekbar_satir"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="9"
                    android:progress="3"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp" />

                <Button
                    android:id="@+id/dugme_satir_arti"
                    android:layout_width="wrap_content"
                    android:minWidth="@dimen/buton_kompakt_min_yukseklik"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- SLIDER 2: Sütun Sayısı (Masaüstü/Çekmece) veya Yuva Sayısı (Alt Bar) -->
            <TextView
                android:id="@+id/yazi_etiket_sutun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↔️ Sütun Sayısı (Columns): 4"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/dugme_sutun_eksi"
                    android:layout_width="wrap_content"
                    android:minWidth="@dimen/buton_kompakt_min_yukseklik"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="−"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekbar_sutun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="9"
                    android:progress="1"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp" />

                <Button
                    android:id="@+id/dugme_sutun_arti"
                    android:layout_width="wrap_content"
                    android:minWidth="@dimen/buton_kompakt_min_yukseklik"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- SLIDER 3: Simge Büyüklüğü (%50 - %150) - Tüm Sekmelerde Ortak -->
            <TextView
                android:id="@+id/yazi_etiket_simge_boyutu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Simge Büyüklüğü: %100"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/dugme_simge_eksi"
                    android:layout_width="wrap_content"
                    android:minWidth="@dimen/buton_kompakt_min_yukseklik"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="−"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekbar_simge_boyutu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp" />

                <Button
                    android:id="@+id/dugme_simge_arti"
                    android:layout_width="wrap_content"
                    android:minWidth="@dimen/buton_kompakt_min_yukseklik"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- MASAÜSTÜ EK CANLI KONTROLLERİ -->
            <LinearLayout
                android:id="@+id/grup_ek_masaustu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <Button
                    android:id="@+id/dugme_kilavuz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="📐 Hücre Kılavuz Çizgileri: Açık"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/dugme_etiket_goster_canli"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="🏷️ Simge Yazıları: Açık"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/dugme_masaustu_dolgu_canli"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="📏 Kenar Boşluğu: Standart"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/dugme_klasor_sekli_canli"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="📁 Klasör Şekli: Squircle (Yuvarlatılmış)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/dugme_gecis_efekti_canli"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="✨ Geçiş Efekti: Standart"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- ÇEKMECE EK CANLI KONTROLLERİ -->
            <LinearLayout
                android:id="@+id/grup_ek_cekmece"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/yazi_etiket_saydamlik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨 Çekmece Şeffaflığı: %100"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/dugme_saydamlik_eksi"
                        android:layout_width="wrap_content"
                        android:minWidth="@dimen/buton_kompakt_min_yukseklik"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                        android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                        android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                        android:background="@drawable/kart_arkaplan"
                        android:text="−"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/seekbar_saydamlik"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100"
                        android:layout_marginLeft="6dp"
                        android:layout_marginRight="6dp" />

                    <Button
                        android:id="@+id/dugme_saydamlik_arti"
                        android:layout_width="wrap_content"
                        android:minWidth="@dimen/buton_kompakt_min_yukseklik"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                        android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                        android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                        android:background="@drawable/kart_arkaplan"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <Button
                    android:id="@+id/dugme_kilavuz_cekmece"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="📐 Hücre Kılavuz Çizgileri: Açık"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/dugme_sik_kullanilanlar_canli"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="⭐ Sık Kullanılanlar Satırı: Açık"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/dugme_cekmece_sekmeleri_canli"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="🏷️ Çekmece Sekmeleri: Görünür"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/dugme_siralama_canli"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="🔤 Menü Sıralaması: A'dan Z'ye"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- ALT BAR (DOCK) EK CANLI KONTROLLERİ -->
            <LinearLayout
                android:id="@+id/grup_ek_dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/dugme_dock_kaydirilabilir_canli"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="🔒 Sabit Alt Bar: Kapalı"
                    android:textColor="#FFA726"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/dugme_dock_stili_canli"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="🎨 Dock Arka Plan Stili: Kayan Yuvarlak Hap"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/dugme_dock_gorunur_canli"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/buton_kompakt_min_yukseklik"
                    android:paddingTop="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:paddingBottom="@dimen/buton_kompakt_ic_bosluk_dikey"
                    android:background="@drawable/kart_arkaplan"
                    android:text="👁️ Alt Bar Görünürlüğü: Görünür"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 4. Esnek Aksiyon Butonları (Sıfırla, İptal, Kaydet) -->
    <com.tamekran.launcher.AkisSatiriLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/dugme_sifirla"
            style="@style/TamEkran.Dugme.Kompakt"
            android:text="Sıfırla"
            android:textColor="#FFA726" />

        <Button
            android:id="@+id/dugme_iptal"
            style="@style/TamEkran.Dugme.Kompakt"
            android:text="İptal"
            android:textColor="#FF5252" />

        <Button
            android:id="@+id/dugme_kaydet"
            style="@style/TamEkran.Dugme.Kompakt"
            android:text="Tamam / Kaydet"
            android:textColor="#69F0AE"
            android:textStyle="bold" />

    </com.tamekran.launcher.AkisSatiriLayout>

</LinearLayout>
