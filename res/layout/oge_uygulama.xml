<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/kapsayici_simge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/oge_simge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/uygulama_adi" />

        <!-- Bildirim Rozeti / Noktası (TeslaUnread / Dots) -->
        <TextView
            android:id="@+id/oge_rozet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:minWidth="18dp"
            android:minHeight="18dp"
            android:background="@drawable/rozet_arkaplan"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/oge_etiket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/renk_yazi_ana"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:shadowColor="#AA000000"
        android:shadowDx="1.0"
        android:shadowDy="1.0"
        android:shadowRadius="2.0" />

</LinearLayout>
